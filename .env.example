# Azure OpenAI (keyless — no secrets in this file)
LLM_PROVIDER=azure
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.services.ai.azure.com/openai/v1/
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=embeddings
AZURE_TOKEN_SCOPE=https://ai.azure.com/.default

# App settings
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl
